# ─── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://kolsense:secret@localhost:5432/kolsense?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

# ─── Embedding ─────────────────────────────────────────────────────────────────
# Provider: "ollama" (local dev) | "dashscope" (production)
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=1536

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# DashScope (production fallback)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ─── LLM ───────────────────────────────────────────────────────────────────────
# Provider: "ollama" (local dev) | "dashscope" (production)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_LLM_MODEL=qwen2.5:14b

# DashScope (production fallback)
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_LLM_MAX_TOKENS=2048
DASHSCOPE_LLM_TEMPERATURE=0.3

# ─── Brief Parser ──────────────────────────────────────────────────────────────
# Confidence threshold below which LLM fallback is triggered (0.0–1.0)
PARSER_CONFIDENCE_THRESHOLD=0.75

# ─── Search ────────────────────────────────────────────────────────────────────
SEARCH_DEFAULT_TOP_K=10
SEARCH_HNSW_EF_SEARCH=64

# ─── Logging ───────────────────────────────────────────────────────────────────
# Level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info
LOG_FORMAT=json
